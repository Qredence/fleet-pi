{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "eslint.config.js",
        ".pi/extensions/**/*.ts",
        "neon.ts",
        "functions/**/*.ts",
        "agent-workspace/scratch/tmp/neon-object-storage-spike.mjs"
      ],
      "project": [
        "scripts/**/*.js",
        ".pi/extensions/**/*.ts",
        "functions/**/*.ts",
        "!agent-workspace/pi/**"
      ],
      "ignoreDependencies": [
        "zod",
        "@neondatabase/serverless",
        "@aws-sdk/s3-presigned-post",
        "@aws-sdk/s3-request-presigner"
      ]
    },
    "apps/web": {
      "ignore": ["src/lib/pi/durable/cloudflare-workers-node-stub.ts"],
      "entry": [
        "scripts/**/*.ts",
        "src/router.tsx",
        "src/routes/__root.tsx",
        "src/routes/**/*.tsx",
        "src/routes/api/**/*.ts",
        "src/lib/pi/chat-runtime/router.ts",
        "src/lib/pi/durable/user-pi-durable.worker.ts",
        "src/lib/**/*.test.ts",
        "src/lib/**/__tests__/**/*.ts",
        "src/lib/**/*.workers.test.ts",
        "src/lib/**/*.spec.ts"
      ],
      "ignoreDependencies": [
        "nitro",
        "cloudflare",
        "@tanstack/router-plugin",
        "tailwindcss",
        "pino-pretty",
        "tslib"
      ]
    },
    "packages/hax-design": {
      "entry": ["src/**/*.tsx", "src/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/pi-protocol": {
      "entry": ["src/**/*.ts", "src/**/__tests__/**/*.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
