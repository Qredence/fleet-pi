#!/bin/bash -eu
# Pre-commit hook: lint + test only affected packages
# Optimized for speed with smart file change detection

echo "→ Running pre-commit checks..." >&2

# Check if any staged files match TypeScript/JavaScript patterns
STAGED_CODE_FILES=$(git diff --cached --name-only --diff-filter=d 2>/dev/null | grep -E '\.(ts|tsx|js|jsx)$' || true)

if [ -z "$STAGED_CODE_FILES" ]; then
    echo "→ No TypeScript/JS code changes, running linter on staged files only" >&2
else
    # Run linting via lint-staged (formatted files only)
    pnpm exec lint-staged
    
    # Identify changed packages by file paths
    if echo "$STAGED_CODE_FILES" | grep -q '^apps/web/.*\.\(ts\|tsx\|js\|jsx\)$'; then
        echo "→ Web package has TypeScript changes, running web tests..." >&2
        if ! (cd apps/web && pnpm test); then
            echo "❌ Web package tests failed" >&2
            exit 1
        fi
    fi
    
    if echo "$STAGED_CODE_FILES" | grep -q '^packages/hax-design/.*\.\(ts\|tsx\|js\|jsx\)$'; then
        echo "→ Hax design package has TypeScript changes, running hax-design tests..." >&2
        if ! (cd packages/hax-design && pnpm test); then
            echo "❌ Hax design package tests failed" >&2
            exit 1
        fi
    fi
    
    if echo "$STAGED_CODE_FILES" | grep -q '^packages/pi-protocol/.*\.\(ts\|tsx\|js\|jsx\)$'; then
        echo "→ Pi protocol package has TypeScript changes, running pi-protocol tests..." >&2
        if ! (cd packages/pi-protocol && pnpm test); then
            echo "❌ Pi protocol package tests failed" >&2
            exit 1
        fi
    fi
fi

echo "→ Pre-commit checks passed ✓" >&2
