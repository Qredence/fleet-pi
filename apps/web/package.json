    "@types/opossum": "^8.1.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vercel/nft": "^1.11.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.9.1",
    "happy-dom": "^20.14.0",
    "jose": "^6.2.11",
    "rollup-plugin-visualizer": "^7.1.1",
    "tsx": "^4.23.13",
