    "@tanstack/router-plugin": "^1.168.35",
    "@types/better-sqlite3": "^7.6.13",
    "@workspace/hax-design": "workspace:*",
    "@workspace/pi-protocol": "workspace:*",
    "better-auth": "^1.7.2",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "nitro": "^3.0.260429-beta",
    "opossum": "^10.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "posthog-js": "^1.427.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tempo-sdk": "^0.0.38",
