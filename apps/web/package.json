{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "build:vercel": "vite build && node scripts/build-vercel-output.mjs",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "auth:migrate": "bash ../../scripts/auth-migrate.sh",
    "chat:migrate": "tsx scripts/chat-migrate.ts",
    "verify-deployment-readiness": "tsx scripts/verify-deployment-readiness.ts",
    "quarantine-orphan-sessions": "tsx scripts/quarantine-orphan-sessions.ts",
    "remap-auth-user-ids": "tsx scripts/remap-auth-user-ids.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@daytona/sdk": "^0.210.0",
