{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fleet-pi-web",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "observability": { "enabled": true },
  // Non-secret config. Secrets (DB URLs, auth, provider keys) go through
  // `wrangler secret`; see docs/wiki/deployment.md.
  "vars": {
    "FLEET_PI_DEPLOYMENT": "cloudflare",
    "NODE_ENV": "production",
  },
  // Worker Previews (PR deploys) do not inherit production secrets; CI uploads
  // an allowlisted secret set per preview. See assert-preview-worker-secrets.ts.
  "previews": {
    "vars": {
      "FLEET_PI_DEPLOYMENT": "cloudflare",
      "FLEET_PI_DEPLOYMENT_TRUST_ZONE": "preview",
      "NODE_ENV": "production",
    },
  },
}
